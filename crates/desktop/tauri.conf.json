{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "消息面分析",
  "version": "0.2.3",
  "identifier": "com.cryptonews.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "消息面分析",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/panda-student/crypto-news/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NjZGMjRBNkQ1M0ZDNUIKUldSYi9GTnRTdkptMWl5Q1ZqOWhNUy9NcGZrbzFjN1dUMFJ0eHRXRkljTFdQZUpsUUN3LzVNWDUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
